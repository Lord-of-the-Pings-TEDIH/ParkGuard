DATABASE_URL=
MODEL_PATH=./models/best.pt
CROPS_DIR=./crops
UPLOAD_DIR=./uploads
FPS_TARGET=8
DETECTION_CONF=0.25
OCR_USE_ANGLE_CLS=true
OCR_MIN_CONF=0.25
OCR_ANGLES=-15,-8,0,8,15
OCR_MIN_SHARPNESS=80.0
TRACK_MAX_AGE=18
TRACK_MIN_IOU=0.20
MIN_TRACK_VOTES=3
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# Mobile-LPR camera intrinsics (police-car camera calibration)
MOBILE_LPR_CAMERA_HEIGHT_M=1.5      # înălțimea camerei deasupra solului
MOBILE_LPR_CAMERA_FOCAL_PX=1000.0   # focal length în pixeli (depinde de lentilă + rezoluție)
MOBILE_LPR_CAMERA_PITCH_DEG=5.0     # tilt în jos față de orizontală (pozitiv = nas în jos)
MOBILE_LPR_PLATE_HEIGHT_M=0.6       # înălțimea medie a plăcuței deasupra solului
MOBILE_LPR_SEARCH_RADIUS_M=3.0      # raza maximă față de spot ca să fie considerat match
